{
  "_meta": {
    "unit": "Air Production Unit (APU), Metro do Porto vehicle",
    "built": "2026-09-05",
    "source": "PRIMARY: Data Description_Metro.pdf, shipped inside the UCI zip for MetroPT-3. SECONDARY (topology and flow path only): Veloso B, Gama J, Ribeiro RP, Pereira PM, A Benchmark dataset for predictive maintenance, arXiv:2207.05466v3, 2022.",
    "warning": "Sensor definitions do NOT carry over cleanly between MetroPT variants: H1 means different things in the 2022 paper and in the MetroPT-3 primary source. Where the two disagree, the primary source wins. No numeric value from the 2022 paper may enter the MetroPT-3 life table.",
    "provenance_field": "every node and edge carries \"sourced\": true when the source states it, false when it is inferred from tag name or flow path",
    "format": "networkx node_link_data compatible; scripts/kg.py will load, not rebuild",
    "revised": "2026-09-05, after reading the primary source. See docs/findings-2026-09-05.md."
  },
  "directed": true,
  "multigraph": false,
