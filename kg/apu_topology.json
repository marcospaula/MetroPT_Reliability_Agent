  },
  "nodes": [
    {
      "id": "atmosphere",
      "type": "Boundary",
      "description": "Ambient air, the source for the compressor",
      "sourced": true
    },
    {
      "id": "clients",
      "type": "Boundary",
      "description": "Downstream consumers: secondary suspension and brakes. No redundancy, so loss of air removes the train from service",
      "sourced": true
    },
    {
      "id": "intake_valve",
      "type": "Equipment",
      "description": "Air intake valve. Opened to start the compressor under load",
      "sourced": true
    },
    {
      "id": "compressor",
      "type": "Equipment",
      "description": "Air compressor with its motor and oil circuit",
      "sourced": true
    },
    {
      "id": "outlet_valve",
      "type": "Equipment",
      "description": "Compressor outlet valve, commanded by DV electric",
      "sourced": true
    },
    {
      "id": "air_dryer",
      "type": "Equipment",
      "description": "Twin-tower air dryer. One tower dries while the other drains the removed humidity",
      "sourced": true
    },
    {
      "id": "dryer_tower_1",
      "type": "Equipment",
      "description": "Dryer tower 1, working when TOWERS is inactive",
      "sourced": true
    },
    {
      "id": "dryer_tower_2",
      "type": "Equipment",
      "description": "Dryer tower 2, working when TOWERS is active",
      "sourced": true
    },
    {
      "id": "drain_pipes",
      "type": "Equipment",
      "description": "Drain pipes opened by a pneumatic pilot valve to discharge water",
      "sourced": true
    },
    {
      "id": "pilot_valve",
      "type": "Equipment",
      "description": "Pneumatic pilot valve commanding the drain pipes. Root cause of a documented air leak in 2022",
      "sourced": true
    },
    {
      "id": "pneumatic_panel",
      "type": "Equipment",
      "description": "Pneumatic panel downstream of the dryer",
      "sourced": true
    },
    {
      "id": "reservoirs",
      "type": "Equipment",
      "description": "Air reservoirs storing compressed air for the clients",
      "sourced": true,
      "source": "UCI zip, Data Description_Metro.pdf (primary source for MetroPT-3)"
    },
    {
      "id": "TP2",
      "type": "Sensor",
      "kind": "analogue",
      "units": "bar",
      "mounted_on": "compressor",
      "description": "Pressure at the compressor",
      "sourced": true
    },
    {
      "id": "TP3",
      "type": "Sensor",
      "kind": "analogue",
      "units": "bar",
      "mounted_on": "pneumatic_panel",
      "description": "Pressure generated at the pneumatic panel",
      "sourced": true
    },
    {
      "id": "H1",
      "type": "Sensor",
      "kind": "analogue",
      "units": "bar",
      "mounted_on": "cyclonic_separator",
      "description": "Pressure generated by the pressure drop when the cyclonic separator filter discharges",
      "sourced": true,
      "source": "UCI zip, Data Description_Metro.pdf (primary source for MetroPT-3)",
      "note": "The 2022 paper describes H1 as a valve opening above 10.2 bar. That is a different variant; the primary source overrides it."
    },
    {
      "id": "DV_pressure",
      "type": "Sensor",
      "kind": "analogue",
      "units": "bar",
      "mounted_on": "air_dryer",
      "description": "Pressure drop when the dryer towers discharge water. Zero means the compressor is working under load",
      "sourced": true
    },
    {
      "id": "Reservoirs",
      "type": "Sensor",
      "kind": "analogue",
      "units": "bar",
      "mounted_on": "reservoirs",
      "description": "Downstream pressure of the reservoirs, which should be close to the pneumatic panel pressure TP3",
      "sourced": true,
      "source": "UCI zip, Data Description_Metro.pdf (primary source for MetroPT-3)"
    },
    {
      "id": "Oil_temperature",
      "type": "Sensor",
      "kind": "analogue",
      "units": "degC",
      "mounted_on": "compressor",
      "description": "Compressor oil temperature",
      "sourced": true
    },
    {
      "id": "Motor_current",
      "type": "Sensor",
      "kind": "analogue",
      "units": "A",
      "mounted_on": "compressor",
      "description": "Current of one phase of the three-phase motor. About 0 A off, 4 A offloaded, 7 A under load, 9 A at start-up",
      "sourced": true,
      "source": "UCI zip, Data Description_Metro.pdf (primary source for MetroPT-3)"
    },
    {
      "id": "COMP",
      "type": "Sensor",
      "kind": "digital",
      "mounted_on": "intake_valve",
      "description": "Electrical signal of the air intake valve. Active when there is no air admission, so the compressor is off or offloaded",
      "sourced": true
    },
    {
      "id": "DV_eletric",
      "type": "Sensor",
      "kind": "digital",
      "mounted_on": "outlet_valve",
      "description": "Commands the compressor outlet valve. Active means working under load",
      "sourced": true
    },
    {
      "id": "Towers",
      "type": "Sensor",
      "kind": "digital",
      "mounted_on": "air_dryer",
      "description": "Inactive means tower 1 is working, active means tower 2",
      "sourced": true
    },
    {
      "id": "MPG",
      "type": "Sensor",
      "kind": "digital",
      "mounted_on": "intake_valve",
      "description": "Activates the intake valve to start the compressor under load when APU pressure falls below 8.2 bar. COMP follows it",
      "sourced": true
    },
    {
      "id": "LPS",
      "type": "Sensor",
      "kind": "digital",
      "mounted_on": "reservoirs",
      "description": "Active when pressure is lower than 7 bar",
      "sourced": true
    },
    {
      "id": "Oil_level",
      "type": "Sensor",
      "kind": "digital",
      "mounted_on": "compressor",
      "description": "Active when oil is below the expected level. By design this does not reach the driver",
      "sourced": true
    },
    {
      "id": "Pressure_switch",
      "type": "Sensor",
      "kind": "digital",
      "mounted_on": "air_dryer",
      "description": "Detects the discharge in the air-drying towers",
      "sourced": true,
      "source": "UCI zip, Data Description_Metro.pdf (primary source for MetroPT-3)"
    },
    {
      "id": "Caudal_impulses",
      "type": "Sensor",
      "kind": "digital",
      "mounted_on": "reservoirs",
      "description": "Counts the pulse outputs generated by the absolute amount of air flowing from the APU to the reservoirs",
      "sourced": true,
      "source": "UCI zip, Data Description_Metro.pdf (primary source for MetroPT-3)"
    },
    {
      "id": "th_mpg_load",
      "type": "Threshold",
      "signal": "MPG",
      "value": 8.2,
      "units": "bar",
      "sense": "below",
      "description": "Intake valve opens, compressor goes under load",
      "sourced": true
    },
    {
      "id": "th_lps",
      "type": "Threshold",
      "signal": "LPS",
      "value": 7.0,
      "units": "bar",
      "sense": "below",
      "description": "Low pressure signal",
      "sourced": true
    },
    {
      "id": "th_current_off",
      "type": "Threshold",
      "signal": "Motor_current",
      "value": 0,
      "units": "A",
      "sense": "about",
      "description": "Compressor off",
      "sourced": true
    },
    {
      "id": "th_current_offload",
      "type": "Threshold",
      "signal": "Motor_current",
      "value": 4,
      "units": "A",
      "sense": "about",
      "description": "Running offloaded",
      "sourced": true
    },
    {
      "id": "th_current_load",
      "type": "Threshold",
      "signal": "Motor_current",
      "value": 7,
      "units": "A",
      "sense": "about",
      "description": "Running under load",
      "sourced": true
    },
    {
      "id": "fm_air_leak_drains",
      "type": "FailureMode",
      "description": "Air leak at the drain pipes from a pilot valve opening them while the compressor runs. Train recovered in service",
      "component": "pilot_valve",
      "sourced": true
    },
    {
      "id": "fm_air_leak_clients",
      "type": "FailureMode",
      "description": "Air leak on the pipe feeding the clients. Train had to be moved to the maintenance building",
      "component": "clients",
      "sourced": true
    },
    {
      "id": "fm_oil_leak",
      "type": "FailureMode",
      "description": "Oil leak at the compressor. No oil warning reaches the driver, so it ran until the motor was damaged and pressure dropped",
      "component": "compressor",
      "sourced": true
    },
    {
      "id": "cyclonic_separator",
      "type": "Equipment",
      "description": "Cyclonic separator filter. Its discharge is what H1 measures",
      "sourced": true,
      "source": "UCI zip, Data Description_Metro.pdf (primary source for MetroPT-3)"
    },
    {
      "id": "th_current_start",
      "type": "Threshold",
      "signal": "Motor_current",
      "value": 9,
      "units": "A",
      "sense": "about",
      "description": "Starting",
      "sourced": true,
      "source": "UCI zip, Data Description_Metro.pdf (primary source for MetroPT-3)"
    }
