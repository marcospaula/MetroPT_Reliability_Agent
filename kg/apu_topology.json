{
  "_meta": {
    "unit": "Air Production Unit (APU), Metro do Porto vehicle",
    "built": "2026-09-06",
    "source": "Veloso B, Gama J, Ribeiro RP, Pereira PM. A Benchmark dataset for predictive maintenance. arXiv:2207.05466v3, 2022. Sections Data Records and Technical Validation.",
    "warning": "The source documents the 2022 MetroPT dataset. Topology and sensor definitions carry over; no numeric value from that paper may enter the MetroPT-3 life table.",
    "provenance_field": "every node and edge carries \"sourced\": true when the source states it, false when it is inferred from tag name or flow path",
    "format": "networkx node_link_data compatible; scripts/kg.py will load, not rebuild"
  },
  "directed": true,
  "multigraph": false,
  "graph": {"name": "apu_topology"},
  "nodes": [
    {"id": "atmosphere", "type": "Boundary", "description": "Ambient air, the source for the compressor", "sourced": true},
    {"id": "clients", "type": "Boundary", "description": "Downstream consumers: secondary suspension and brakes. No redundancy, so loss of air removes the train from service", "sourced": true},

    {"id": "intake_valve", "type": "Equipment", "description": "Air intake valve. Opened to start the compressor under load", "sourced": true},
    {"id": "compressor", "type": "Equipment", "description": "Air compressor with its motor and oil circuit", "sourced": true},
    {"id": "outlet_valve", "type": "Equipment", "description": "Compressor outlet valve, commanded by DV electric", "sourced": true},
    {"id": "air_dryer", "type": "Equipment", "description": "Twin-tower air dryer. One tower dries while the other drains the removed humidity", "sourced": true},
    {"id": "dryer_tower_1", "type": "Equipment", "description": "Dryer tower 1, working when TOWERS is inactive", "sourced": true},
    {"id": "dryer_tower_2", "type": "Equipment", "description": "Dryer tower 2, working when TOWERS is active", "sourced": true},
    {"id": "drain_pipes", "type": "Equipment", "description": "Drain pipes opened by a pneumatic pilot valve to discharge water", "sourced": true},
    {"id": "pilot_valve", "type": "Equipment", "description": "Pneumatic pilot valve commanding the drain pipes. Root cause of a documented air leak in 2022", "sourced": true},
    {"id": "pneumatic_panel", "type": "Equipment", "description": "Pneumatic panel downstream of the dryer", "sourced": true},
    {"id": "reservoirs", "type": "Equipment", "description": "Air reservoirs storing compressed air for the clients", "sourced": false},
    {"id": "pressure_switch", "type": "Equipment", "description": "Command pressure switch referenced as the trigger for H1", "sourced": false},

    {"id": "TP2", "type": "Sensor", "kind": "analogue", "units": "bar", "mounted_on": "compressor", "description": "Pressure at the compressor", "sourced": true},
    {"id": "TP3", "type": "Sensor", "kind": "analogue", "units": "bar", "mounted_on": "pneumatic_panel", "description": "Pressure generated at the pneumatic panel", "sourced": true},
    {"id": "H1", "type": "Sensor", "kind": "analogue", "units": "bar", "mounted_on": "pressure_switch", "description": "Valve activated when the command pressure switch reads above 10.2 bar", "sourced": true},
    {"id": "DV_pressure", "type": "Sensor", "kind": "analogue", "units": "bar", "mounted_on": "air_dryer", "description": "Pressure drop when the dryer towers discharge water. Zero means the compressor is working under load", "sourced": true},
    {"id": "Reservoirs", "type": "Sensor", "kind": "analogue", "units": "bar", "mounted_on": "reservoirs", "description": "Reservoir pressure. INFERRED from the tag name; not described in the source", "sourced": false},
    {"id": "Oil_temperature", "type": "Sensor", "kind": "analogue", "units": "degC", "mounted_on": "compressor", "description": "Compressor oil temperature", "sourced": true},
    {"id": "Motor_current", "type": "Sensor", "kind": "analogue", "units": "A", "mounted_on": "compressor", "description": "Motor current. About 0 A off, 4 A offloaded, 7 A under load", "sourced": true},

    {"id": "COMP", "type": "Sensor", "kind": "digital", "mounted_on": "intake_valve", "description": "Electrical signal of the air intake valve. Active when there is no air admission, so the compressor is off or offloaded", "sourced": true},
    {"id": "DV_electric", "type": "Sensor", "kind": "digital", "mounted_on": "outlet_valve", "description": "Commands the compressor outlet valve. Active means working under load", "sourced": true},
    {"id": "TOWERS", "type": "Sensor", "kind": "digital", "mounted_on": "air_dryer", "description": "Inactive means tower 1 is working, active means tower 2", "sourced": true},
    {"id": "MPG", "type": "Sensor", "kind": "digital", "mounted_on": "intake_valve", "description": "Activates the intake valve to start the compressor under load when APU pressure falls below 8.2 bar. COMP follows it", "sourced": true},
    {"id": "LPS", "type": "Sensor", "kind": "digital", "mounted_on": "reservoirs", "description": "Active when pressure is lower than 7 bar", "sourced": true},
    {"id": "Oil_Level", "type": "Sensor", "kind": "digital", "mounted_on": "compressor", "description": "Active when oil is below the expected level. By design this does not reach the driver", "sourced": true},
    {"id": "Pressure_Switch", "type": "Sensor", "kind": "digital", "mounted_on": "pressure_switch", "description": "Command pressure switch state. INFERRED from the tag name; not described in the source", "sourced": false},
    {"id": "Caudal_Impulse", "type": "Sensor", "kind": "digital", "mounted_on": "reservoirs", "description": "Flow pulse. INFERRED from the tag name; not described in the source", "sourced": false},

    {"id": "th_mpg_load", "type": "Threshold", "signal": "MPG", "value": 8.2, "units": "bar", "sense": "below", "description": "Intake valve opens, compressor goes under load", "sourced": true},
    {"id": "th_h1", "type": "Threshold", "signal": "H1", "value": 10.2, "units": "bar", "sense": "above", "description": "Operating pressure of the command pressure switch", "sourced": true},
    {"id": "th_lps", "type": "Threshold", "signal": "LPS", "value": 7.0, "units": "bar", "sense": "below", "description": "Low pressure signal", "sourced": true},
    {"id": "th_current_off", "type": "Threshold", "signal": "Motor_current", "value": 0, "units": "A", "sense": "about", "description": "Compressor off", "sourced": true},
    {"id": "th_current_offload", "type": "Threshold", "signal": "Motor_current", "value": 4, "units": "A", "sense": "about", "description": "Running offloaded", "sourced": true},
    {"id": "th_current_load", "type": "Threshold", "signal": "Motor_current", "value": 7, "units": "A", "sense": "about", "description": "Running under load", "sourced": true},

    {"id": "fm_air_leak_drains", "type": "FailureMode", "description": "Air leak at the drain pipes from a pilot valve opening them while the compressor runs. Train recovered in service", "component": "pilot_valve", "sourced": true},
    {"id": "fm_air_leak_clients", "type": "FailureMode", "description": "Air leak on the pipe feeding the clients. Train had to be moved to the maintenance building", "component": "clients", "sourced": true},
    {"id": "fm_oil_leak", "type": "FailureMode", "description": "Oil leak at the compressor. No oil warning reaches the driver, so it ran until the motor was damaged and pressure dropped", "component": "compressor", "sourced": true}
  ],
  "links": [
